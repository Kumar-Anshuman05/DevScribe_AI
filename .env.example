# ==============================================================================
# DevScribe AI — Environment Configuration Template
# ==============================================================================

# Database Connections (Tri-Tier Connection Architecture)
# 1. Prisma Transaction Pooler (Supabase Port 6543 with pgbouncer=true)
DATABASE_URL="postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"

# 2. Direct Connection for Migrations (Supabase Port 5432)
DIRECT_URL="postgresql://postgres:[password]@db.[ref].supabase.co:5432/postgres"

# 3. LangGraph PostgresSaver Dedicated Session Connection (Port 5432 or Session Pooler)
CHECKPOINTER_DATABASE_URL="postgresql://postgres:[password]@db.[ref].supabase.co:5432/postgres"

# Supabase Auth & Storage
NEXT_PUBLIC_SUPABASE_URL="https://[ref].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOi..."
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOi..."

# Google Gemini API (@google/genai)
GEMINI_API_KEY="AIzaSy..."
GEMINI_MODEL_FAST="gemini-2.5-flash"
GEMINI_MODEL_REASONING="gemini-2.5-flash"

# Grounding & Search Provider
# Options: gemini_grounding | tavily | duckduckgo
RESEARCH_SEARCH_PROVIDER="gemini_grounding"
TAVILY_API_KEY=""

# Inngest Durable Orchestration
INNGEST_EVENT_KEY="local"
INNGEST_SIGNING_KEY="local"

# Security & Encryption
# 32-byte Hex string (64 characters) for AES-256-GCM webhook secret encryption
# Generate via: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WEBHOOK_ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"
